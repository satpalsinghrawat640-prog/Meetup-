<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>MeetUp</title>
<style>
:root{--pink:#ff2d7a;--coral:#ff7a59;--purple:#8e2de2;--ink:#2b2b3a;--mute:#8a8a99;--bg:#fff7f9}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg);overflow:hidden}
.screen{display:none;position:fixed;inset:0;flex-direction:column}
.screen.on{display:flex}
button{font:inherit;border:0;cursor:pointer}
input,select,textarea{font:inherit;width:100%;padding:14px 16px;border:1.5px solid #eee;border-radius:14px;background:#fff;outline:none;color:var(--ink)}
input:focus,select:focus,textarea:focus{border-color:var(--pink)}
.grad{background:linear-gradient(160deg,var(--purple) 0%,var(--pink) 55%,var(--coral) 100%)}

/* ---------- login ---------- */
#login{color:#fff;align-items:center;justify-content:space-between;padding:48px 24px 32px;overflow:hidden;position:fixed}
#login .bg{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.heart{position:absolute;bottom:-60px;opacity:.0;animation:floatUp linear infinite;font-size:28px}
@keyframes floatUp{0%{transform:translateY(0) scale(.8);opacity:0}15%{opacity:.5}100%{transform:translateY(-110vh) scale(1.3);opacity:0}}
.bubble{position:absolute;border-radius:50%;border:3px solid rgba(255,255,255,.7);box-shadow:0 8px 24px rgba(0,0,0,.2);background-size:cover;background-position:center;animation:bob 6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-14px)}}
.logo{position:relative;z-index:2;text-align:center;margin-top:20px}
.logo .mark{width:88px;height:88px;margin:0 auto 12px;background:#fff;border-radius:28px;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 30px rgba(0,0,0,.25)}
.logo h1{font-size:40px;letter-spacing:.5px;font-weight:800}
.logo p{font-size:18px;opacity:.95;margin-top:6px}
.card-login{position:relative;z-index:2;width:100%;max-width:420px}
.card-login input{margin-bottom:12px;background:rgba(255,255,255,.95)}
.btn{width:100%;padding:16px;border-radius:999px;font-weight:700;font-size:17px}
.btn.white{background:#fff;color:var(--pink);box-shadow:0 8px 20px rgba(0,0,0,.18)}
.btn.pink{background:linear-gradient(90deg,var(--pink),var(--coral));color:#fff;box-shadow:0 8px 20px rgba(255,45,122,.35)}
.btn:disabled{opacity:.6}
.link{background:none;color:#fff;text-decoration:underline;margin-top:14px;width:100%;font-size:15px}
.err{color:#fff;background:rgba(0,0,0,.25);padding:10px 14px;border-radius:12px;margin-bottom:12px;font-size:14px;display:none}
.small{font-size:12px;opacity:.85;text-align:center;margin-top:10px}
.or{display:flex;align-items:center;gap:12px;margin:14px 0;opacity:.9;font-size:14px}
.or:before,.or:after{content:"";flex:1;height:1px;background:rgba(255,255,255,.5)}
.btn.gbtn{background:#fff;color:#3c4043;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 8px 20px rgba(0,0,0,.18)}

/* ---------- setup ---------- */
#setup{overflow-y:auto;background:var(--bg)}
#setup header{padding:36px 24px 28px;color:#fff;text-align:center}
#setup header h2{font-size:26px}
#setup header p{opacity:.9;margin-top:4px}
#setup form{padding:20px 22px 40px;max-width:480px;width:100%;margin:0 auto}
#setup label{display:block;font-size:13px;color:var(--mute);margin:14px 0 6px;font-weight:600}
.photo-pick{width:130px;height:130px;border-radius:50%;margin:-60px auto 0;background:#fff center/cover;border:4px solid #fff;box-shadow:0 8px 24px rgba(0,0,0,.18);display:flex;align-items:center;justify-content:center;font-size:42px;position:relative;cursor:pointer}
.photo-pick span{position:absolute;bottom:2px;right:2px;background:var(--pink);color:#fff;width:36px;height:36px;border-radius:50%;font-size:20px;display:flex;align-items:center;justify-content:center}
.err.dark{background:#ffe3ec;color:#c0134f}

/* ---------- app ---------- */
#app{background:var(--bg)}
.topbar{display:flex;align-items:center;justify-content:center;padding:14px 16px 8px;gap:8px;font-weight:800;font-size:24px}
.topbar b{background:linear-gradient(90deg,var(--pink),var(--coral));-webkit-background-clip:text;background-clip:text;color:transparent}
.tabs-body{flex:1;position:relative;overflow:hidden}
.tab{display:none;position:absolute;inset:0;overflow-y:auto;padding:6px 14px 16px}
.tab.on{display:block}
#tab-home{overflow:hidden;display:none}
#tab-home.on{display:flex;flex-direction:column}
.deck{flex:1;position:relative;margin:4px 0 8px}
.pcard{position:absolute;inset:0;border-radius:24px;background:#ddd center/cover;box-shadow:0 10px 30px rgba(0,0,0,.2);touch-action:none;overflow:hidden;user-select:none}
.pcard .shade{position:absolute;left:0;right:0;bottom:0;padding:60px 18px 18px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.75))}
.pcard h3{font-size:26px}
.pcard p{opacity:.92;margin-top:4px;font-size:15px}
.stamp{position:absolute;top:28px;font-size:28px;font-weight:800;border:4px solid;border-radius:10px;padding:2px 12px;opacity:0;transform:rotate(-14deg)}
.stamp.l{left:22px;color:#3ddc97;border-color:#3ddc97}
.stamp.p{right:22px;color:#ff4d6d;border-color:#ff4d6d;transform:rotate(14deg)}
.actions{display:flex;justify-content:center;align-items:center;gap:22px;padding:8px 0 4px}
.rb{width:62px;height:62px;border-radius:50%;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.15);font-size:28px;display:flex;align-items:center;justify-content:center}
.rb.sm{width:50px;height:50px;font-size:22px}
.empty{text-align:center;color:var(--mute);padding:60px 24px}
.empty .big{font-size:56px}
.navbar{display:flex;background:#fff;border-top:1px solid #f0e6ea;padding:6px 0 max(8px,env(safe-area-inset-bottom))}
.navbar button{flex:1;background:none;color:#b9b4bb;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;padding:6px}
.navbar button svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.navbar button.on{color:var(--pink)}
.navbar button.on svg{fill:rgba(255,45,122,.15)}
.section-t{font-weight:700;margin:12px 4px 10px}
.strip{display:flex;gap:12px;overflow-x:auto;padding-bottom:8px}
.mchip{flex:0 0 auto;width:70px;text-align:center;font-size:12px}
.mchip .av{width:70px;height:70px;border-radius:50%;background:#ddd center/cover;border:3px solid var(--pink);margin-bottom:4px}
.row{display:flex;align-items:center;gap:12px;background:#fff;border-radius:16px;padding:10px;margin-bottom:10px;box-shadow:0 2px 10px rgba(0,0,0,.05)}
.row .av{width:56px;height:56px;border-radius:50%;background:#ddd center/cover}
.row small{color:var(--mute)}
.me{text-align:center;padding-top:10px}
.me .av{width:140px;height:140px;border-radius:50%;margin:0 auto 12px;background:#ddd center/cover;border:4px solid #fff;box-shadow:0 8px 24px rgba(255,45,122,.3)}
.me h2{font-size:24px}
.me p{color:var(--mute);margin:8px 20px 20px}
.me .btn{max-width:320px;margin-bottom:10px}
.btn.line{background:#fff;color:var(--pink);border:2px solid var(--pink)}

/* match overlay */
#matchov{display:none;position:fixed;inset:0;z-index:50;color:#fff;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px}
#matchov.on{display:flex}
#matchov h1{font-size:40px;margin-bottom:8px}
#matchov .pics{display:flex;gap:-10px;margin:22px 0}
#matchov .pics div{width:120px;height:120px;border-radius:50%;background:#ddd center/cover;border:4px solid #fff;margin:0 -10px}
#matchov .btn{max-width:300px;margin-top:12px}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#333;color:#fff;padding:10px 18px;border-radius:999px;font-size:14px;z-index:99;display:none}
</style>
</head>
<body>

<!-- ================= LOGIN ================= -->
<div id="login" class="screen grad on">
  <div class="bg" id="bg"></div>
  <div class="logo">
    <div class="mark">
      <svg width="54" height="54" viewBox="0 0 64 64"><defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8e2de2"/><stop offset="1" stop-color="#ff7a59"/></linearGradient></defs><path d="M32 56S6 40 6 22C6 13 13 8 20 8c5 0 9 3 12 7 3-4 7-7 12-7 7 0 14 5 14 14 0 18-26 34-26 34z" fill="url(#g1)"/><circle cx="24" cy="26" r="3" fill="#fff"/><circle cx="32" cy="26" r="3" fill="#fff"/><circle cx="40" cy="26" r="3" fill="#fff"/></svg>
    </div>
    <h1>MeetUp</h1>
    <p>अपना मैच ढूंढो 💕</p>
  </div>
  <div class="card-login">
    <div class="err" id="lerr"></div>
    <input id="lemail" type="email" placeholder="ईमेल" autocomplete="email">
    <input id="lpass" type="password" placeholder="पासवर्ड (कम से कम 6 अक्षर)" autocomplete="current-password">
    <button class="btn white" id="lbtn">लॉगिन करो</button>
    <div class="or" id="orDiv"><span>या</span></div>
    <button class="btn gbtn" id="gbtn">
      <svg width="22" height="22" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.4 5.7c4.3-4 6.9-9.9 6.9-17.1z"/><path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-2.9-.8-4.7s.3-3.3.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
      Google से जारी रखो
    </button>
    <button class="link" id="ltoggle">नए हो? साइन-अप करो</button>
    <div class="small">18 साल या उससे ज़्यादा उम्र वालों के लिए</div>
  </div>
</div>

<!-- ================= PROFILE SETUP ================= -->
<div id="setup" class="screen">
  <header class="grad"><h2>अपनी प्रोफ़ाइल बनाओ</h2><p>ताकि लोग तुम्हें पहचान सकें</p></header>
  <form id="sform" onsubmit="return false">
    <div class="photo-pick" id="photoPick"><div id="photoIcon">📷</div><span>+</span></div>
    <input type="file" id="photoFile" accept="image/*" hidden>
    <label>नाम</label><input id="sname" maxlength="30" placeholder="तुम्हारा नाम">
    <label>जन्मतिथि (18+ ज़रूरी)</label><input id="sdob" type="date">
    <label>मैं हूँ</label>
    <select id="sgender"><option value="male">पुरुष</option><option value="female">महिला</option><option value="other">अन्य</option></select>
    <label>मुझे मिलना है</label>
    <select id="sinto"><option value="female">महिलाओं से</option><option value="male">पुरुषों से</option><option value="all">सबसे</option></select>
    <label>मेरे बारे में</label><textarea id="sbio" rows="3" maxlength="200" placeholder="छोटा सा बायो लिखो…"></textarea>
    <div class="err dark" id="serr" style="margin-top:14px"></div>
    <button class="btn pink" id="sbtn" style="margin-top:18px">आगे बढ़ो 🚀</button>
  </form>
</div>

<!-- ================= MAIN APP ================= -->
<div id="app" class="screen">
  <div class="topbar"><svg width="26" height="26" viewBox="0 0 64 64"><path d="M32 56S6 40 6 22C6 13 13 8 20 8c5 0 9 3 12 7 3-4 7-7 12-7 7 0 14 5 14 14 0 18-26 34-26 34z" fill="#ff2d7a"/></svg><b>MeetUp</b></div>
  <div class="tabs-body">
    <section class="tab on" id="tab-home">
      <div class="deck" id="deck"></div>
      <div class="actions">
        <button class="rb" id="bPass" style="color:#ff4d6d">✕</button>
        <button class="rb sm" id="bSuper" style="color:#3aa0ff">★</button>
        <button class="rb" id="bLike" style="color:#3ddc97">♥</button>
      </div>
    </section>
    <section class="tab" id="tab-explore">
      <div class="empty"><div class="big">🔍</div><p style="margin-top:10px">एक्सप्लोर और फ़िल्टर अगले हिस्से में आ रहा है</p></div>
    </section>
    <section class="tab" id="tab-msgs"></section>
    <section class="tab" id="tab-me"></section>
  </div>
  <nav class="navbar" id="nav">
    <button data-t="home" class="on"><svg viewBox="0 0 24 24"><path d="M12 22s-8-5.5-8-12a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.5-8 12-8 12z"/></svg>होम</button>
    <button data-t="explore"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>सर्च</button>
    <button data-t="msgs"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-5.4A8 8 0 1 1 21 12z"/></svg>मैसेज</button>
    <button data-t="me"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>प्रोफ़ाइल</button>
  </nav>
</div>

<!-- match overlay -->
<div id="matchov" class="grad">
  <h1>It's a Match! 💘</h1>
  <p id="matchtxt">तुम दोनों ने एक-दूसरे को लाइक किया</p>
  <div class="pics"><div id="mA"></div><div id="mB"></div></div>
  <button class="btn white" id="mGo">मैसेज भेजो</button>
  <button class="link" id="mClose">स्वाइप करते रहो</button>
</div>
<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { initializeAuth, indexedDBLocalPersistence, browserLocalPersistence, browserSessionPersistence,
  createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut,
  GoogleAuthProvider, signInWithPopup, browserPopupRedirectResolver }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getFirestore, doc, getDoc, setDoc, getDocs, collection, query, where, limit, serverTimestamp }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyCU8Vk4S1z_PgUPiEGEWaprMUNTMS2sxao",
  authDomain: "meetup-find-your-partner.firebaseapp.com",
  projectId: "meetup-find-your-partner",
  storageBucket: "meetup-find-your-partner.firebasestorage.app",
  messagingSenderId: "561251220717",
  appId: "1:561251220717:web:221253e9f995699ea7a0e4"
};
const app = initializeApp(firebaseConfig);
const auth = initializeAuth(app, {
  persistence: [indexedDBLocalPersistence, browserLocalPersistence, browserSessionPersistence],
  popupRedirectResolver: browserPopupRedirectResolver
});
const db = getFirestore(app);

const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const toast = (t) => { const e = $("toast"); e.textContent = t; e.style.display = "block"; setTimeout(() => e.style.display = "none", 2500); };
const show = id => { document.querySelectorAll(".screen").forEach(s => s.classList.remove("on")); $(id).classList.add("on"); };
const ageOf = dob => { const d = new Date(dob), n = new Date(); let a = n.getFullYear() - d.getFullYear(); const m = n.getMonth() - d.getMonth(); if (m < 0 || (m === 0 && n.getDate() < d.getDate())) a--; return a; };

/* ---------- login background (hearts + bubbles) ---------- */
(function decorate() {
  const bg = $("bg");
  for (let i = 0; i < 14; i++) {
    const h = document.createElement("div"); h.className = "heart"; h.textContent = ["💗","💖","💕","❤️"][i % 4];
    h.style.left = (Math.random() * 95) + "%"; h.style.animationDuration = (7 + Math.random() * 8) + "s"; h.style.animationDelay = (Math.random() * 8) + "s";
    bg.appendChild(h);
  }
  const cols = [["#ffd1dc","#ff9eb5"],["#d9c2ff","#a98bff"],["#ffd9b3","#ffb27a"],["#c2f0ff","#7fd3ee"]];
  const pos = [[8,14,74],[72,10,62],[80,34,86],[4,42,58]];
  pos.forEach((p, i) => {
    const b = document.createElement("div"); b.className = "bubble";
    b.style.cssText = `left:${p[0]}%;top:${p[1]}%;width:${p[2]}px;height:${p[2]}px;background-image:linear-gradient(135deg,${cols[i][0]},${cols[i][1]});animation-delay:${i * 0.8}s;display:flex;align-items:center;justify-content:center;font-size:${p[2] / 2}px`;
    b.textContent = ["🙂","😊","😍","😎"][i]; bg.appendChild(b);
  });
})();

/* ---------- login / signup ---------- */
let signupMode = false;
const msgs = {
  "auth/invalid-email": "ईमेल सही नहीं है",
  "auth/missing-password": "पासवर्ड डालो",
  "auth/weak-password": "पासवर्ड कम से कम 6 अक्षर का रखो",
  "auth/email-already-in-use": "ये ईमेल पहले से रजिस्टर है, लॉगिन करो",
  "auth/invalid-credential": "ईमेल या पासवर्ड गलत है",
  "auth/user-not-found": "ये अकाउंट नहीं मिला",
  "auth/wrong-password": "पासवर्ड गलत है",
  "auth/network-request-failed": "इंटरनेट चेक करो",
  "auth/operation-not-allowed": "Firebase में Email/Password चालू नहीं है",
  "auth/too-many-requests": "बहुत कोशिशें हो गईं, थोड़ी देर बाद करो"
};
function lerr(t) { const e = $("lerr"); e.textContent = t; e.style.display = t ? "block" : "none"; }
$("ltoggle").onclick = () => {
  signupMode = !signupMode;
  $("lbtn").textContent = signupMode ? "साइन-अप करो" : "लॉगिन करो";
  $("ltoggle").textContent = signupMode ? "पहले से अकाउंट है? लॉगिन करो" : "नए हो? साइन-अप करो";
  lerr("");
};
$("lbtn").onclick = async () => {
  lerr(""); const email = $("lemail").value.trim(), pass = $("lpass").value;
  $("lbtn").disabled = true;
  try {
    if (signupMode) await createUserWithEmailAndPassword(auth, email, pass);
    else await signInWithEmailAndPassword(auth, email, pass);
  } catch (e) { lerr(msgs[e.code] || ("गड़बड़: " + (e.code || e.message))); }
  $("lbtn").disabled = false;
};

$("gbtn").onclick = async () => {
  lerr(""); $("gbtn").disabled = true;
  try { await signInWithPopup(auth, new GoogleAuthProvider(), browserPopupRedirectResolver); }
  catch (e) {
    const c = e.code || "";
    if (c === "auth/popup-closed-by-user" || c === "auth/cancelled-popup-request") { /* user ne band kiya */ }
    else if (c === "auth/unauthorized-domain") lerr("Firebase में ये डोमेन Authorized domains में जोड़ो → " + (location.hostname ? location.hostname : "(खाली: " + location.protocol + " — इसे जोड़ा नहीं जा सकता)"));
    else if (c === "auth/operation-not-supported-in-this-environment" || c === "auth/popup-blocked" || c === "auth/web-storage-unsupported")
      lerr("इस ऐप के अंदर Google लॉगिन नहीं चल पा रहा, ईमेल से लॉगिन करो या ब्राउज़र में खोलो");
    else if (c === "auth/operation-not-allowed") lerr("Firebase में Google साइन-इन चालू नहीं है");
    else lerr("Google लॉगिन में गड़बड़: " + (c || e.message));
  }
  $("gbtn").disabled = false;
};

/* ---------- profile setup ---------- */
let photoData = "";
$("photoPick").onclick = () => $("photoFile").click();
$("photoFile").onchange = async (e) => {
  const f = e.target.files[0]; if (!f) return;
  photoData = await resizePhoto(f, 640);
  $("photoPick").style.backgroundImage = `url(${photoData})`; $("photoIcon").style.display = "none";
};
function resizePhoto(file, max) {
  return new Promise((res, rej) => {
    const fr = new FileReader();
    fr.onload = () => { const img = new Image(); img.onload = () => {
      const k = Math.min(1, max / Math.max(img.width, img.height));
      const c = document.createElement("canvas"); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
      c.getContext("2d").drawImage(img, 0, 0, c.width, c.height); res(c.toDataURL("image/jpeg", 0.72)); };
      img.onerror = rej; img.src = fr.result; };
    fr.onerror = rej; fr.readAsDataURL(file);
  });
}
function serr(t) { const e = $("serr"); e.textContent = t; e.style.display = t ? "block" : "none"; }
$("sbtn").onclick = async () => {
  serr("");
  const name = $("sname").value.trim(), dob = $("sdob").value;
  if (!photoData) return serr("एक फ़ोटो ज़रूर लगाओ");
  if (name.length < 2) return serr("नाम डालो");
  if (!dob) return serr("जन्मतिथि डालो");
  const age = ageOf(dob);
  if (age < 18) return serr("माफ़ करना, ये ऐप सिर्फ़ 18 साल या उससे ज़्यादा उम्र वालों के लिए है");
  if (age > 99) return serr("जन्मतिथि सही डालो");
  $("sbtn").disabled = true;
  try {
    const profile = { uid: auth.currentUser.uid, name, dob, age, gender: $("sgender").value, interestedIn: $("sinto").value,
      bio: $("sbio").value.trim(), photo: photoData, createdAt: serverTimestamp() };
    await setDoc(doc(db, "users", auth.currentUser.uid), profile);
    me = profile; enterApp();
  } catch (e) { serr("सेव नहीं हुआ: " + (e.code || e.message)); }
  $("sbtn").disabled = false;
};

/* ---------- session ---------- */
let me = null;
onAuthStateChanged(auth, async (u) => {
  if (!u) { me = null; show("login"); return; }
  try {
    const s = await getDoc(doc(db, "users", u.uid));
    if (s.exists()) { me = s.data(); enterApp(); }
    else { if (u.displayName && !$("sname").value) $("sname").value = u.displayName; show("setup"); }
  } catch (e) { toast("लोड नहीं हुआ: " + (e.code || e.message)); show("login"); }
});

/* ---------- app shell ---------- */
function enterApp() { show("app"); switchTab("home"); loadDeck(); renderMe(); }
$("nav").onclick = (e) => { const b = e.target.closest("button"); if (b) switchTab(b.dataset.t); };
function switchTab(t) {
  document.querySelectorAll("#nav button").forEach(b => b.classList.toggle("on", b.dataset.t === t));
  document.querySelectorAll(".tab").forEach(s => s.classList.toggle("on", s.id === "tab-" + t));
  if (t === "msgs") loadMatches();
}

/* ---------- swipe deck ---------- */
let queue = [];
async function loadDeck() {
  $("deck").innerHTML = `<div class="empty"><div class="big">⏳</div><p>लोग ढूंढ रहे हैं…</p></div>`;
  try {
    const seen = new Set();
    (await getDocs(query(collection(db, "likes"), where("from", "==", me.uid)))).forEach(d => seen.add(d.data().to));
    const all = await getDocs(query(collection(db, "users"), limit(200)));
    queue = [];
    all.forEach(d => {
      const u = d.data();
      if (u.uid === me.uid || seen.has(u.uid)) return;
      if (me.interestedIn !== "all" && u.gender !== me.interestedIn) return;
      if (u.interestedIn !== "all" && u.interestedIn !== me.gender) return;
      queue.push(u);
    });
    queue.sort(() => Math.random() - 0.5);
  } catch (e) { $("deck").innerHTML = `<div class="empty"><p>लोड नहीं हुआ: ${esc(e.code || e.message)}</p></div>`; return; }
  drawDeck();
}
function drawDeck() {
  const deck = $("deck"); deck.innerHTML = "";
  if (!queue.length) {
    deck.innerHTML = `<div class="empty"><div class="big">💫</div><p style="margin-top:10px">अभी के लिए बस इतने ही लोग।<br>थोड़ी देर बाद फिर देखना!</p><button class="btn pink" id="reload" style="margin-top:18px;max-width:220px">फिर से ढूंढो</button></div>`;
    $("reload").onclick = loadDeck; return;
  }
  queue.slice(0, 2).reverse().forEach((u, i, arr) => deck.appendChild(makeCard(u, i === arr.length - 1)));
}
function makeCard(u, top) {
  const c = document.createElement("div"); c.className = "pcard"; c.style.backgroundImage = `url(${u.photo})`;
  if (!top) c.style.transform = "scale(.95) translateY(10px)";
  c.innerHTML = `<div class="stamp l">LIKE</div><div class="stamp p">PASS</div><div class="shade"><h3>${esc(u.name)}, ${esc(u.age)}</h3><p>${esc(u.bio || "")}</p></div>`;
  if (top) attachDrag(c, u);
  return c;
}
function attachDrag(c, u) {
  let sx = 0, sy = 0, dx = 0, drag = false;
  c.onpointerdown = e => { drag = true; sx = e.clientX; sy = e.clientY; c.setPointerCapture(e.pointerId); c.style.transition = "none"; };
  c.onpointermove = e => { if (!drag) return; dx = e.clientX - sx; const dy = (e.clientY - sy) * 0.3;
    c.style.transform = `translate(${dx}px,${dy}px) rotate(${dx / 18}deg)`;
    c.querySelector(".stamp.l").style.opacity = Math.min(1, Math.max(0, dx / 100));
    c.querySelector(".stamp.p").style.opacity = Math.min(1, Math.max(0, -dx / 100)); };
  c.onpointerup = () => { if (!drag) return; drag = false;
    if (dx > 100) decide("like"); else if (dx < -100) decide("pass");
    else { c.style.transition = "transform .25s"; c.style.transform = ""; c.querySelectorAll(".stamp").forEach(s => s.style.opacity = 0); } dx = 0; };
}
async function decide(type) {
  if (!queue.length) return;
  const u = queue.shift(); const top = $("deck").lastElementChild;
  if (top && top.classList.contains("pcard")) {
    top.style.transition = "transform .3s,opacity .3s";
    top.style.transform = type === "pass" ? "translateX(-130%) rotate(-25deg)" : type === "super" ? "translateY(-130%)" : "translateX(130%) rotate(25deg)";
    top.style.opacity = 0;
  }
  setTimeout(drawDeck, 260);
  try {
    await setDoc(doc(db, "likes", me.uid + "_" + u.uid), { from: me.uid, to: u.uid, type, at: serverTimestamp() });
    if (type !== "pass") {
      const back = await getDoc(doc(db, "likes", u.uid + "_" + me.uid));
      if (back.exists() && back.data().type !== "pass") {
        const id = [me.uid, u.uid].sort().join("_");
        await setDoc(doc(db, "matches", id), { users: [me.uid, u.uid], at: serverTimestamp() });
        showMatch(u);
      }
    }
  } catch (e) { toast("सेव नहीं हुआ: " + (e.code || e.message)); }
}
$("bPass").onclick = () => decide("pass");
$("bLike").onclick = () => decide("like");
$("bSuper").onclick = () => decide("super");
function showMatch(u) {
  $("mA").style.backgroundImage = `url(${me.photo})`; $("mB").style.backgroundImage = `url(${u.photo})`;
  $("matchtxt").textContent = `तुम और ${u.name} ने एक-दूसरे को लाइक किया`; $("matchov").classList.add("on");
}
$("mClose").onclick = () => $("matchov").classList.remove("on");
$("mGo").onclick = () => { $("matchov").classList.remove("on"); switchTab("msgs"); };

/* ---------- matches / messages ---------- */
async function loadMatches() {
  const box = $("tab-msgs"); box.innerHTML = `<div class="empty"><p>लोड हो रहा है…</p></div>`;
  try {
    const ms = await getDocs(query(collection(db, "matches"), where("users", "array-contains", me.uid)));
    const people = [];
    for (const m of ms.docs) { const other = m.data().users.find(x => x !== me.uid); const s = await getDoc(doc(db, "users", other)); if (s.exists()) people.push(s.data()); }
    if (!people.length) { box.innerHTML = `<div class="empty"><div class="big">💌</div><p style="margin-top:10px">अभी कोई मैच नहीं।<br>स्वाइप करते रहो!</p></div>`; return; }
    box.innerHTML = `<div class="section-t">नए मैच</div><div class="strip">${people.map(p => `<div class="mchip"><div class="av" style="background-image:url(${p.photo})"></div>${esc(p.name)}</div>`).join("")}</div>
      <div class="section-t">मैसेज</div>${people.map(p => `<div class="row" data-n="${esc(p.name)}"><div class="av" style="background-image:url(${p.photo})"></div><div><b>${esc(p.name)}</b><br><small>चैट अगले हिस्से में आएगी 💬</small></div></div>`).join("")}`;
    box.querySelectorAll(".row").forEach(r => r.onclick = () => toast("चैट अगले हिस्से में जुड़ेगी"));
  } catch (e) { box.innerHTML = `<div class="empty"><p>लोड नहीं हुआ: ${esc(e.code || e.message)}</p></div>`; }
}

/* ---------- my profile ---------- */
function renderMe() {
  $("tab-me").innerHTML = `<div class="me"><div class="av" style="background-image:url(${me.photo})"></div><h2>${esc(me.name)}, ${esc(me.age)}</h2><p>${esc(me.bio || "बायो नहीं है")}</p>
    <button class="btn line" id="editSoon">प्रोफ़ाइल एडिट (जल्द)</button><button class="btn pink" id="logout">लॉगआउट</button></div>`;
  $("editSoon").onclick = () => toast("एडिट अगले हिस्से में आएगा");
  $("logout").onclick = () => signOut(auth);
}
</script>
